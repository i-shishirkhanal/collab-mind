# CollabMind AI — environment for `docker compose` (copy to `.env`; never commit the real file).
# Generate every secret with:  openssl rand -hex 32
# Per-service examples with the full option lists: backend/.env.example, ai/.env.example.

# ── Required (compose refuses to start without these) ───────────────────────────
# Postgres with the pgvector extension. Apply supabase/migrations/*.sql in order first
# (docs/phase4-deployment-checklist.md). Supabase: use the Session-pooler string if you lack IPv6.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
REDIS_PASSWORD=
JWT_SECRET=                 # >= 32 chars; signs session tokens
AI_SERVICE_TOKEN=           # >= 32 chars; shared by backend and AI service
NEXTAUTH_SECRET=            # >= 32 chars; frontend session cookie

# ── Backend ─────────────────────────────────────────────────────────────────────
NODE_ENV=development        # production additionally requires SMTP_URL and refuses silent local-file fallback
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_URL=http://localhost:3000
JWT_EXPIRES_IN=7d
# Verification / password-reset mail. Without it (non-production only) links are printed to the backend log.
SMTP_URL=
MAIL_FROM=
# File storage: unset = local volume (/app/uploads). With a bucket, GCS credentials must be available to the container.
GCS_BUCKET_NAME=
# Messaging attachments (Supabase Storage, private bucket "chat-files") and calls (LiveKit). Backend only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── AI service ──────────────────────────────────────────────────────────────────
# Chat/study/research models (DeepSeek). Without a key chat and study tools return 503.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://inference.dahl.global/v1
LLM_MODEL_FLASH=deepseek-ai/DeepSeek-V4-Flash-0731
LLM_MODEL_PRO=deepseek-ai/DeepSeek-V4-Flash-0731
LLM_FALLBACK_PRO_TO_FLASH=false
# BGE-M3 embeddings (OpenAI-compatible /embeddings). Without it indexing and retrieval return 503.
#   bundled CPU server:  docker compose --profile embeddings up -d   then   EMBEDDING_BASE_URL=http://embeddings:80/v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RETRIEVAL_MIN_SIMILARITY=0.35
