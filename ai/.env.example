# .env.example — Copy this file to .env and fill in your real values.
# The app reads these at runtime via python-dotenv.
# NEVER commit your real .env file to Git (add .env to .gitignore).

# ── Chat / study / research models (DeepSeek) ──────────────────────────────────
# Server-side only. Never expose in the frontend or NEXT_PUBLIC_* variables.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://inference.dahl.global/v1
# Default chat + study tasks: DeepSeek V4.1 Flash
LLM_MODEL_FLASH=deepseek-ai/DeepSeek-V4-Flash-0731
# Complex research / reasoning: DeepSeek V4 Pro
LLM_MODEL_PRO=deepseek-ai/DeepSeek-V4-Flash-0731
# Thinking mode per tier: enabled | disabled | default (provider default)
LLM_FLASH_THINKING=default
LLM_PRO_THINKING=default
# Route clearly analytical questions to Pro automatically (callers can always force a task)
LLM_AUTO_ROUTE_RESEARCH=true
# Retry transient failures (429/5xx/timeouts) with exponential backoff
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_MAX_OUTPUT_TOKENS=4096
# OFF by default. When true, a Pro request that still fails after retries is served by Flash;
# every response reports the model actually used (route.model_used, route.fallback_used).
LLM_FALLBACK_PRO_TO_FLASH=false

# ── Embeddings (BAAI/bge-m3, 1024-d dense) ─────────────────────────────────────
# Any OpenAI-compatible /embeddings server that serves bge-m3, e.g.
#   self-hosted HF text-embeddings-inference:  http://embeddings:80/v1   (docker compose --profile embeddings up)
#   hosted SiliconFlow:                        https://api.siliconflow.com/v1  (+ EMBEDDING_API_KEY)
# No fallback exists: if this is unset/unreachable, indexing and retrieval return 503.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
# Must equal the pgvector column (vector(1024)); verified at startup and on every response.
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2

# ── Retrieval ──────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=30
# Cosine similarity floor for a chunk to reach the model. Calibrate on your own documents.
RETRIEVAL_MIN_SIMILARITY=0.35
# Lower floor for chunks that also match the keyword (full-text) query
RETRIEVAL_FTS_RESCUE_MIN_SIMILARITY=0.25
RETRIEVAL_HYBRID=true
RETRIEVAL_RRF_K=60
RAG_CONTEXT_MAX_CHARS=24000

# ── PostgreSQL (with pgvector) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/collabmind
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>

# ── Service authentication ─────────────────────────────────────────────────────
# Shared secret the Express backend sends as "Authorization: Bearer <token>".
# Same value as AI_SERVICE_TOKEN in backend/.env. >= 32 chars (openssl rand -hex 32).
# The service refuses to start without it; only /health is unauthenticated.
AI_SERVICE_TOKEN=
# Redis requires a password: redis://:<REDIS_PASSWORD>@localhost:6379
# REDIS_URL=
# Serve /docs and /openapi.json (unauthenticated; local development only)
# AI_ENABLE_DOCS=true

# ── Google Cloud Storage ───────────────────────────────────────────────────────
# Path to your GCS service account JSON key file.
# Used by google-cloud-storage to authenticate when downloading files from GCS.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Document extraction runs in a throw-away child process (killed on the deadline).
EXTRACTION_TIMEOUT_SECONDS=180
EXTRACTION_CONCURRENCY=2        # parsers running at once; each can use up to EXTRACTION_MEMORY_MB
EXTRACTION_MEMORY_MB=1536       # address-space cap per parser (enforced on Linux; Windows relies on the deadline)
EXTRACTION_ISOLATION=process    # "thread" = legacy in-process parsing (tests only)

# Optional neural reranker (needs requirements-ml.txt). Off by default; falls back to the current order on any error.
RERANKER_ENABLED=false
RERANKER_MODEL=
RERANKER_CANDIDATES=30

# Optional claim-level faithfulness verifier (needs requirements-ml.txt). Off by default; answers are simply left unscored on any error.
# Train it with ml/verifier/train_verifier.py (see ml/build_kaggle_notebook.py), then point VERIFIER_MODEL at the saved folder.
VERIFIER_ENABLED=false
VERIFIER_MODEL=
VERIFIER_THRESHOLD=0.5          # P(supported) below this flags a claim; pick it on the dev set
VERIFIER_MAX_CLAIMS=12
VERIFIER_CALIB_A=1.0              # Platt scaling from ml/calibration/calibrate_verifier.py (1.0 / 0.0 = off)
VERIFIER_CALIB_B=0.0

# Optional learned prompt-injection screen of retrieved passages (needs requirements-ml.txt). Off by default; fail-open.
# Train with ml/injection/train_injection.py, then point INJECTION_DETECTOR_MODEL at the saved folder.
INJECTION_DETECTOR_ENABLED=false
INJECTION_DETECTOR_MODEL=
INJECTION_DETECTOR_THRESHOLD=0.5   # a passage whose worst window scores >= this is withheld from the model
INJECTION_DETECTOR_WINDOW_CHARS=1200
