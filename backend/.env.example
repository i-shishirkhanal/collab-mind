# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/collabmind

# Redis (password required; use hex so it is URL-safe: openssl rand -hex 24)
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379
# memory (default) or redis (shared counters across instances)
RATE_LIMIT_STORE=memory

# Sessions. Generate: openssl rand -hex 32  (>= 32 chars; placeholders are rejected)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Shared secret between this backend and the AI service (same value in ai/.env).
# Generate: openssl rand -hex 32
AI_SERVICE_TOKEN=
AI_SERVICE_URL=http://localhost:8000

# Browser origins allowed to call the API / sockets (comma separated, no "*")
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public URL of the frontend (used in verification / reset email links)
APP_URL=http://localhost:3000
# Set to the number of reverse proxies in front of the API (enables X-Forwarded-For)
# TRUST_PROXY=1

# Email (verification + password reset). Required in production.
# Without SMTP_URL, outside production, links are printed to this server's console.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=CollabMind <no-reply@example.com>

# Google Cloud Storage (document storage)
GCS_BUCKET_NAME=your_gcs_bucket_name
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/gcp/service/account/key.json
